{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2UI component reference types",
  "description": "The ComponentId and ChildList definitions used by the contact catalog, from the A2UI 0.9.1 common types.",
  "$defs": {
    "ComponentId": { "type": "string" },
    "ChildList": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/ComponentId" } },
        {
          "type": "object",
          "properties": {
            "componentId": { "$ref": "#/$defs/ComponentId" },
            "path": { "type": "string" }
          },
          "required": ["componentId", "path"],
          "additionalProperties": false
        }
      ]
    }
  }
}
